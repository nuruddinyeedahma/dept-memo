{
  "buildCommand": "cd web && rm -rf node_modules && npm install && npm run build",
  "outputDirectory": "web/dist",
  "installCommand": "npm install",
  "regions": ["sin1"],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
